# ============================================================================
# LOCAL usage only - the normal flow is GitHub Actions (docs/CI_DEPLOYMENT.md).
# In CI, terraform reads everything from TF_VAR_* environment variables that
# the workflows export from repo secrets; this file is NOT used there.
# ============================================================================

# --- connection -------------------------------------------------------------
auth            = "ApiKey"             # ApiKey | SecurityToken (Cloud Shell) | InstancePrincipal
region          = "us-ashburn-1"       # your HOME region (best A1 availability)
tenancy_ocid    = "ocid1.tenancy.oc1..aaaa..."
user_ocid       = "ocid1.user.oc1..aaaa..."
fingerprint     = "aa:bb:cc:..."
private_key_path = "~/.ssh/oci_api_key.pem"   # local file (CI uses private_key content)

compartment_ocid = ""                  # empty = tenancy root compartment

# --- SSH access ----------------------------------------------------------------
# Leave both empty to let terraform generate a dedicated keypair
# (private key then appears in `terraform output ssh_private_key_pem`).
ssh_public_key       = ""
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# --- instances -------------------------------------------------------------------
runner_profile      = "always-on"      # always-on (2 OCPU/12 GB, 24/7) | burst (4/24, wake on demand)
a1_boot_volume_gb   = 147              # 50 (waker) + 147 = 197 of the 200 GB free envelope (max: 150)
availability_domain_index = 0          # bump if 'Out of capacity'

admin_cidr     = "0.0.0.0/0"           # ideally your own IP, e.g. "203.0.113.5/32"
enable_waker   = true                  # free AMD micro: status page + wake/self-heal
status_public  = false                 # true = expose waker status page to admin_cidr

# --- safety -----------------------------------------------------------------------
preserve_boot_volume = false           # keep A1 disk across terraform destroy

# --- over-provision protection ----------------------------------------------------
# Terraform refuses to create the A1 worker when live A1 OCPUs in the compartment
# plus the planned worker would exceed this (plan-time precondition). 4 = the
# post-June-2026 Always Free tenancy envelope; free-only accounts (stopped
# above 2 OCPU / 12 GB) should use 2. CI: set via TF_VAR_overprovision_max_ocpus.
overprovision_max_ocpus = 4
