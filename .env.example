# ============================================================================
# oci-github-runner controller configuration
# Copy to .env on the A1 worker VM (deploy/install.sh does this for you),
# edit, then: sudo systemctl restart oci-runner.service
# ============================================================================

# --- GitHub auth -------------------------------------------------------------

# pat  : classic Personal Access Token. Simplest. Scopes:
#        repo-scoped runners  -> classic PAT with `repo` scope (private repos)
#                                or `public_repo` (public repos only)
#        org-scoped runners   -> classic PAT with `admin:org` scope
#        (fine-grained PATs also work: "Administration: RW", "Metadata: R",
#         "Actions: R" on the target repos)
# app  : GitHub App (recommended for orgs; tokens auto-refresh, better rate
#        limits, no 90-day expiry). See docs/GITHUB_APP_SETUP.md.
AUTH_MODE=pat
GITHUB_PAT=

# GitHub App credentials (only when AUTH_MODE=app).
# GH_APP_PRIVATE_KEY accepts the PEM with literal \n escapes, e.g.
#   GH_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
# or point GH_APP_PRIVATE_KEY_FILE at a mounted PEM (deploy/secrets/app.pem).
GH_APP_ID=
GH_INSTALLATION_ID=
GH_APP_PRIVATE_KEY=
#GH_APP_PRIVATE_KEY_FILE=/opt/oci-runner/secrets/app.pem

# --- Where runners register ----------------------------------------------------

# repo : GITHUB_REPOSITORIES=owner/repo[,owner2/repo2]  (queue-aware scaling)
# org  : GITHUB_ORGANIZATION=myorg                      (static pool; see docs)
SCOPE_TYPE=repo
GITHUB_REPOSITORIES=your-github-username/your-repo
#GITHUB_ORGANIZATION=my-org

# --- Runner pool ------------------------------------------------------------------

# Labels assigned to every runner. Match your workflows:
#   runs-on: [self-hosted, oracle-a1]
# (the runner adds self-hosted/Linux/<host arch> automatically)
RUNNER_LABELS=oracle-a1

# Only queued jobs carrying at least one of these labels are counted for
# scaling decisions (comma separated).
MATCH_LABELS=oracle-a1

# Optional runner group (org scope only, default group if empty).
RUNNER_GROUP=

# Pool size. Sizing guide for the default Always Free shapes:
#   always-on (2 OCPU / 12 GB) -> MIN=1 MAX=2 RUNNER_MEMORY_GB=5
#   burst     (4 OCPU / 24 GB) -> MIN=1 MAX=4 RUNNER_MEMORY_GB=5.5
MIN_RUNNERS=1
MAX_RUNNERS=2
RUNNER_MEMORY_GB=5

# Per-runner CPU cap (docker --cpus). Empty = uncapped (jobs share the VM).
RUNNER_CPUS=

# Runner image (built by deploy/install.sh).
RUNNER_IMAGE=oci-runner/runner:latest

# Let jobs use `docker build` / `docker run` through the host docker daemon
# (sibling containers). Disable if you do not need docker-in-CI.
MOUNT_DOCKER_SOCK=true

CONTAINER_PREFIX=gha-runner

# --- Behaviour -----------------------------------------------------------------------

POLL_INTERVAL=15          # seconds between queue polls
HOUSEKEEP_INTERVAL=300    # seconds between housekeeping sweeps
PRUNE_INTERVAL=21600      # seconds between docker prunes (6 h)

# Burst profile only: power the VM off after this many idle minutes.
# The waker VM brings it back when jobs queue up.
ENABLE_IDLE_STOP=false
IDLE_STOP_MINUTES=20

# --- Status page ---------------------------------------------------------------------

# The compose file publishes 127.0.0.1:8080 only. Reach it via SSH tunnel:
#   ssh -N -L 8080:localhost:8080 ubuntu@<a1-ip>
STATUS_BIND=0.0.0.0
STATUS_PORT=8080

# Optional shared secret; then requests need ?token=... or X-Status-Token.
STATUS_TOKEN=
