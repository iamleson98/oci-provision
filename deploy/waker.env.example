# ============================================================================
# Waker service configuration (AMD micro VM, /opt/oci-runner-waker/waker.env)
# deploy/install.sh copies this template; fill it in, then
#   sudo systemctl restart oci-waker.service
# ============================================================================

# --- GitHub auth (same values as the controller .env) ------------------------
AUTH_MODE=pat
GITHUB_PAT=
#AUTH_MODE=app
#GH_APP_ID=
#GH_INSTALLATION_ID=
#GH_APP_PRIVATE_KEY=

# --- Scopes to watch (same as controller) --------------------------------------
SCOPE_TYPE=repo
GITHUB_REPOSITORIES=your-github-username/your-repo
#SCOPE_TYPE=org
#GITHUB_ORGANIZATION=my-org
MATCH_LABELS=oracle-a1

# --- Waker behaviour --------------------------------------------------------------
# OCID of the A1 worker instance (terraform output a1_instance_id)
A1_INSTANCE_ID=ocid1.instance...

# true  -> 'always-on' profile: restart the A1 worker whenever it is stopped
#          (self-healing against Oracle idle reclamation / crashes).
#          Stop `oci-waker.service` before doing maintenance.
# false -> 'burst' profile: only start the worker when jobs are queued.
ALWAYS_RESUME=false

WAKER_POLL_INTERVAL=20     # seconds between GitHub queue polls
WAKE_DEBOUNCE_S=150       # minimum seconds between START API calls

# Leave empty to use instance principals (recommended; IAM policy comes from
# Terraform). Set a profile name to use ~/.oci/config API-key auth instead.
OCI_CONFIG_PROFILE=

# --- Status page (this one is meant to be reachable) ------------------------------
STATUS_BIND=0.0.0.0
STATUS_PORT=8080
# Strongly recommended if you expose the port through the security list.
STATUS_TOKEN=change-me-please
