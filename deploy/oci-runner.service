[Unit]
Description=oci-github-runner controller (docker compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/oci-runner
ExecStartPre=/usr/bin/docker compose -f /opt/oci-runner/deploy/compose.yml build controller
ExecStart=/usr/bin/docker compose -f /opt/oci-runner/deploy/compose.yml up -d --wait
ExecStop=/usr/bin/docker compose -f /opt/oci-runner/deploy/compose.yml down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
